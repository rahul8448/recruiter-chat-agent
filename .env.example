# Copy this file to .env and fill in your key, or run `ant auth login` instead
# and skip this file entirely.
ANTHROPIC_API_KEY=

# Logging verbosity: DEBUG, INFO (default), WARNING, ERROR, CRITICAL.
# An unrecognized value falls back to INFO with a warning rather than failing.
# LOG_LEVEL=INFO

# File locations. The defaults live inside the installed package, which is
# ephemeral (and often read-only) in a container — point these at a mounted
# volume for any real deployment.
# INQUIRIES_PATH=/data/inquiries.json
# PROFILE_PATH=/config/profile.yaml

# Optional: get a push notification (via ntfy.sh) the moment a recruiter
# leaves their contact info. Pick a private, hard-to-guess topic name (ntfy
# topics aren't access-controlled by default — anyone who knows the name can
# read it) and subscribe to it in the ntfy app or at https://ntfy.sh/<topic>.
# Leave blank to disable — leave_contact_request works fine without it.
NTFY_TOPIC=
# Only needed if you're self-hosting ntfy instead of using ntfy.sh.
# NTFY_SERVER=https://ntfy.sh

# recruiter-chat-web (Gradio) only. Left blank on purpose — recruiters can
# open the link and start chatting with no login. Rate limiting below (on by
# default, no setup needed) is the actual defense against abuse. Only set
# this if you specifically want a login wall — comma-separated "user:pass"
# pairs, e.g. one per recruiter you're expecting.
# RECRUITER_CHAT_AUTH=recruiter:changeme,rahul:another-password

# recruiter-chat-web only — protects your API bill from a scripted flood.
# Two tiers: a per-conversation cap (SESSION_*) plus a broader per-IP
# backstop (IP_*), since a browser reload gets a fresh session and would
# otherwise dodge the session-only limit. Defaults shown; only set these to
# override.
# SESSION_RATE_LIMIT_MAX_MESSAGES=20
# SESSION_RATE_LIMIT_WINDOW_SECONDS=600
# IP_RATE_LIMIT_MAX_MESSAGES=60
# IP_RATE_LIMIT_WINDOW_SECONDS=600

# Optional: encrypt data/inquiries.json at rest (recruiter name/email/phone/
# messages). Leave blank and it's stored as plain JSON (still permission-
# restricted to your user, but readable by anything with filesystem access).
# Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key means losing the ability to read the file — back it up
# somewhere other than this repo (it's not something to commit).
# INQUIRIES_ENCRYPTION_KEY=
